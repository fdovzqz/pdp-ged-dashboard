{
  "name": "pagob-dgo-caso-exito",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:seed": "convex run seedData:seedAllData",
    "convex:seed:prod": "convex run seedData:seedAllData --prod",
    "convex:seed-annual": "node scripts/seedAnnualToConvex.js",
    "convex:seed-annual:prod": "node scripts/seedAnnualToConvex.js --prod",
    "convex:seed-intraday": "convex run seedData:seedIntradayData",
    "convex:seed-intraday:prod": "convex run seedData:seedIntradayData --prod",
    "convex:seed:notes": "convex run seedData:seedAnalysisNotes",
    "convex:seed:notes:prod": "convex run seedData:seedAnalysisNotes --prod",
    "convex:clear": "node scripts/clearConvexTables.js",
    "convex:clear:prod": "node scripts/clearConvexTables.js --prod",
    "convex:full-reset": "node scripts/fullResetAndReextract.js",
    "convex:full-reset:prod": "node scripts/fullResetAndReextract.js --prod",
    "convex:cancel-reextract": "convex run mutations:cancelReextract",
    "convex:validate-daily": "convex run cloudwatch:runDailyValidationFromCloudWatch",
    "validate-annual": "npx tsx scripts/validateAnnualConvex.ts",
    "generate-hourly": "node scripts/generateHourlyByDay.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.975.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "convex": "^1.31.6",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.28.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.21"
  }
}
